<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.zkdoc</groupId>
    <artifactId>zkdoc-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>zkdoc-platform</name>
    <description>Zero-knowledge document-verification platform</description>

    <modules>
        <module>zkdoc-core-crypto</module>
        <module>zkdoc-document</module>
        <module>zkdoc-credential</module>
        <module>zkdoc-zkp</module>
        <module>zkdoc-keys</module>
        <module>zkdoc-api</module>
    </modules>

    <properties>
        <java.version>26</java.version>
        <maven.compiler.release>26</maven.compiler.release>
        <sqlite.version>3.53.4.0</sqlite.version>
        <bucket4j.version>8.19.0</bucket4j.version>
        <zxing.version>3.5.4</zxing.version>
        <bulletproofs.version>1.0.11</bulletproofs.version>
    </properties>

    <!-- Required by the published Weavechain Bulletproofs metadata for keccakj. -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

</project>
