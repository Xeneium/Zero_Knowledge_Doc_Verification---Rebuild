<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.13</version>
        <relativePath/>
    </parent>

    <groupId>com.zkdoc</groupId>
    <artifactId>zkdoc-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>zkdoc-platform</name>
    <description>Zero-knowledge document-verification platform</description>

    <modules>
        <module>zkdoc-core-crypto</module>
        <module>zkdoc-document</module>
        <module>zkdoc-credential</module>
        <module>zkdoc-zkp</module>
        <module>zkdoc-keys</module>
        <module>zkdoc-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <flyway.version>10.17.0</flyway.version>
        <sqlite.version>3.46.1.0</sqlite.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <zxing.version>3.5.3</zxing.version>
        <bulletproofs.version>1.0.11</bulletproofs.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-java-21</id>
                        <phase>validate</phase>
                        <goals><goal>toolchain</goal></goals>
                        <configuration>
                            <toolchains>
                                <jdk><version>21</version></jdk>
                            </toolchains>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
