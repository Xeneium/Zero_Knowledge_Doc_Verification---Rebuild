# ==============================================================================
# Zero-Knowledge Document Verification Platform - .gitignore
# ==============================================================================

# === Maven & Build Outputs ===
target/
**/target/

# === IDE & Editors ===
.idea/
*.iml
.classpath
.project
.settings/
.vscode/
nbproject/
nbactions.xml
nb-configuration.xml

# === Operating System Files ===
.DS_Store
Thumbs.db
Desktop.ini

# === Environment, Secrets & Private Configuration ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# === Database & Local State ===
data/
*.db
*.sqlite
*.sqlite3

# === Logs & Diagnostics ===
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Java / JVM Runtime Artifacts ===
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# === Frontend Node.js Build Artifacts ===
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/node/
**/node_modules/

# === Security Scanners & Secret Detection ===
.scannerwork/
.semgrep/
.trivy/
gitleaks-report.json
gitleaks-report.sarif
.gitleaks/
*.leak
dump.txt
files.txt
poms.txt
scratch/
test-reports/
*.dump
*.dumpstream

# === Backup Archives ===
backups/
*.tar.gz

# === Temporary & Cache Files ===
*.tmp
*.bak
*.swp
*~
.vitest/
frontend/.vitest/

# === Maven Wrapper ===
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

tmp/
output/
tmp_*
