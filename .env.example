# Local PostgreSQL Configuration (for Docker Compose / Local Dev)
POSTGRES_DB=zkdoc
POSTGRES_USER=zkdoc_dev
POSTGRES_PASSWORD=dev_password_change_in_prod
POSTGRES_PORT=5432

# Spring Boot Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zkdoc
SPRING_DATASOURCE_USERNAME=zkdoc_dev
SPRING_DATASOURCE_PASSWORD=dev_password_change_in_prod
SERVER_PORT=8080

# Public verification external base URL
ZKDOC_PUBLIC_VERIFICATION_BASE_URL=http://localhost:8080

# Logging profile (local, dev, prod)
SPRING_PROFILES_ACTIVE=local

# Document and Artifact Storage
ZKDOC_STORAGE_TYPE=filesystem
ZKDOC_STORAGE_DIR=./data/artifacts

# Backup and Recovery Operations
BACKUP_DIR=./backups
RETENTION_DAYS=7
# Optional: Set secret for AES-256 backup encryption
BACKUP_ENCRYPTION_KEY=
# Optional: Set secret for HMAC-SHA256 manifest authentication
BACKUP_HMAC_KEY=
