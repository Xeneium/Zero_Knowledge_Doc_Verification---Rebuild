# Local PostgreSQL Configuration (for Docker Compose / Local Dev)
POSTGRES_DB=zkdoc
POSTGRES_USER=zkdoc_app
# WARNING: MUST be set to a strong random secret before running docker compose or deployment
POSTGRES_PASSWORD=<GENERATE_SECURE_RANDOM_PASSWORD>
POSTGRES_PORT=5432

# Spring Boot Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zkdoc
SPRING_DATASOURCE_USERNAME=zkdoc_app
SPRING_DATASOURCE_PASSWORD=<GENERATE_SECURE_RANDOM_PASSWORD>
SERVER_PORT=8080

# Public verification external base URL
ZKDOC_PUBLIC_VERIFICATION_BASE_URL=http://localhost:8080

# Logging profile (local, dev, prod)
SPRING_PROFILES_ACTIVE=local

# Document and Artifact Storage
ZKDOC_STORAGE_TYPE=filesystem
ZKDOC_STORAGE_DIR=./data/artifacts

# Document Storage Envelope Encryption (AES-256-GCM)
ZKDOC_STORAGE_ENCRYPTION_ENABLED=true
ZKDOC_STORAGE_ENCRYPTION_KEY_ID=primary-storage-key
# 256-bit (32 bytes) hex-encoded or Base64 secret key for AES-256-GCM artifact encryption
ZKDOC_STORAGE_ENCRYPTION_KEY=<GENERATE_32_BYTE_HEX_OR_BASE64_KEY>

# Backup and Recovery Operations
BACKUP_DIR=./backups
RETENTION_DAYS=7
# Optional: Set secret for AES-256 backup encryption
BACKUP_ENCRYPTION_KEY=
# Optional: Set secret for HMAC-SHA256 manifest authentication
BACKUP_HMAC_KEY=
